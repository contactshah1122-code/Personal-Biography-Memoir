# Digital Life Archive - Environment Variables Configuration
# Copy this file to .env and adjust variables as required

# Flask Secret Key for session and CSRF signing (use a long random string in production)
SECRET_KEY=archive-memoir-super-secret-key-change-in-production

# Database URL
# For local SQLite development (default):
DATABASE_URL=sqlite:///instance/database.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://archive_user:archive_pass@localhost:5432/digital_archive

# Application Environment
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
